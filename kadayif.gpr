with "config/kadayif_config.gpr";
project Kadayif is

   for Source_Dirs use ("src/**", "config/");
   for Object_Dir use "obj/" & Kadayif_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("main.adb");

   package Builder is
      for Executable ("main.adb") use "kadayif";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        Kadayif_Config.Ada_Compiler_Switches & ("-gnat2022");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Kadayif;
